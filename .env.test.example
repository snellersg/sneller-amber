# Environment variables for testing
# Copy this file to .env.test and fill in your actual values

# Test Supabase instance (separate from production)
NEXT_PUBLIC_SUPABASE_URL_TEST=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_TEST=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY_TEST=your-test-service-role-key

# Test configuration
NODE_ENV=test
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Optional: Lighthouse CI GitHub App Token
LHCI_GITHUB_APP_TOKEN=your-lighthouse-token

# Optional: Artillery load testing configuration  
LOAD_TEST_TARGET_URL=http://localhost:3000
LOAD_TEST_DURATION=60
LOAD_TEST_RATE=10