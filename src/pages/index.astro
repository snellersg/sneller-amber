---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import KindIcon from "@/components/KindIcon.astro";
import { Badge } from "@/components/starwind/badge";
import { Input } from "@/components/starwind/input";
import { linkKind, linkKindLabel } from "@/lib/link-kind";
import SearchIcon from "@tabler/icons/outline/search.svg";
import ExternalIcon from "@tabler/icons/outline/external-link.svg";

const groups = (await getCollection("docs")).map((entry) => entry.data);
const total = groups.reduce((n, g) => n + g.items.length, 0);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<BaseLayout title="Quick Access">
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <label class="relative block sm:w-72">
      <span class="sr-only">Search quick access links</span>
      <SearchIcon class="text-muted-foreground pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2" />
      <Input id="doc-search" type="search" size="sm" placeholder={`Search ${total} links`} class="bg-card pl-8" autocomplete="off" />
    </label>
    <nav aria-label="Jump to category" class="flex flex-wrap gap-2">
      {
        groups.map((g) => (
          <Badge href={`#${slug(g.category)}`} tone="neutral" appearance="outline" size="sm" class="bg-card">
            {g.category}
            <span class="text-muted-foreground">{g.items.length}</span>
          </Badge>
        ))
      }
    </nav>
  </div>

  <div class="bg-card border-border overflow-hidden rounded-lg border shadow-xs">
    {
      groups.map((g) => (
        <section id={slug(g.category)} data-group class="scroll-mt-18">
          <h2 class="bg-background border-border text-muted-foreground flex items-center justify-between border-b px-3 py-1 font-sans text-xs font-bold tracking-wider uppercase">
            {g.category}
            <span data-count class="font-normal">{g.items.length}</span>
          </h2>
          <ul class="divide-border border-border divide-y border-b">
            {g.items.map((item) => {
              const kind = linkKind(item.url);
              return (
                <li data-search={`${item.title} ${item.description} ${g.category}`.toLowerCase()}>
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={item.description}
                    class="group hover:bg-muted/50 flex items-center gap-3 px-3 py-2 transition-colors focus-visible:outline-offset-[-2px]"
                  >
                    <KindIcon kind={kind} class="size-4 shrink-0" />
                    <span class="min-w-0 flex-1 sm:flex sm:items-baseline sm:gap-3">
                      <span class="block truncate text-sm font-bold sm:w-64 sm:shrink-0">{item.title}</span>
                      <span class="text-muted-foreground block truncate text-xs sm:text-sm">{item.description}</span>
                    </span>
                    <ExternalIcon class="text-muted-foreground group-hover:text-primary size-4 shrink-0" aria-hidden="true" />
                    <span class="sr-only">(opens {linkKindLabel[kind]} in a new tab)</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
    <p id="doc-empty" hidden class="text-muted-foreground px-3 py-6 text-center text-sm">No links match your search.</p>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById("doc-search") as HTMLInputElement | null;
  const empty = document.getElementById("doc-empty");
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-group]"));

  function filter() {
    const terms = (input?.value ?? "").toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const group of groups) {
      const rows = Array.from(group.querySelectorAll<HTMLElement>("li[data-search]"));
      let visible = 0;
      for (const row of rows) {
        const match = terms.every((t) => row.dataset.search!.includes(t));
        row.hidden = !match;
        if (match) visible++;
      }
      group.hidden = visible === 0;
      group.querySelector("[data-count]")!.textContent = String(visible);
      shown += visible;
    }
    if (empty) empty.hidden = shown > 0;
  }

  input?.addEventListener("input", filter);

  // "/" focuses search, like most docs sites.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "/" || e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    e.preventDefault();
    input?.focus();
  });
</script>
