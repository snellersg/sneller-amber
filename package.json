{
  "name": "sneller-amber-v2",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "20.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "next build",
    "build:verify": "npm run type-check && npm run lint && npm run build",
    "build:analyze": "ANALYZE=true npm run build",
    "dev": "next dev -p 3000",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:all": "npm run test:lint && npm run test:type && npm run test:unit && npm run test:integration && npm run test:build",
    "test:lint": "npm run lint && npm run format:check",
    "test:type": "npm run type-check",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:unit:watch": "jest --testPathPattern=__tests__/unit --watch",
    "test:unit:coverage": "jest --testPathPattern=__tests__/unit --coverage",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:api": "jest --testPathPattern=__tests__/api",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:mobile": "playwright test tests/mobile",
    "test:network-conditions": "playwright test tests/network",
    "test:mobile:performance": "lighthouse-ci",
    "test:build": "npm run build:verify && npm run test:unit",
    "test:build:all": "npm run test:all && npm run build",
    "test:deploy": "npm run test:build:all",
    "test:performance": "lighthouse-ci --collect.numberOfRuns=3",
    "test:load": "artillery run load-test.yml",
    "test:debug": "jest --testPathPattern=__tests__ --verbose --no-cache",
    "test:verbose": "jest --verbose",
    "security:audit": "npm audit --audit-level=moderate",
    "security:deps": "npm audit --audit-level=high",
    "security:fix": "npm audit fix",
    "analyze:bundle": "npm run build:analyze",
    "clean": "rm -rf .next node_modules/.cache .turbo coverage",
    "prepare": "husky install",
    "pre-commit": "npm run test:lint && npm run test:type && npm run test:unit",
    "setup-tests": "node scripts/setup-tests.js"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.75.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.90.2",
    "autoprefixer": "^10.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.445.0",
    "next": "^16.0.10",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.14.5",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.0.0",
    "postcss": "^8",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
