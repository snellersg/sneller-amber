{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-console": ["warn", { "allow": ["error", "warn"] }],
    "prefer-const": "error",
    "no-unused-vars": "off",
    "no-undef": "off",
    "no-useless-escape": "error",
    "no-redeclare": "error",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "semi": ["error", "never"]
  },
  "ignorePatterns": ["page.tsx", "node_modules/", ".next/", "dist/", "build/"]
}